# Copy to .env and fill in. Never commit the real .env (already gitignored).

PORT=3001

# Single-user login for the app itself (independent of any network-layer
# access control you put in front of it, e.g. a reverse proxy or VPN).
# Generate a bcrypt hash, e.g.: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
APP_PASSWORD_HASH=

# Random long string used to sign session cookies.
SESSION_SECRET=

# VoIP.ms account-level API credentials (Account -> API Control in the portal).
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=

# Shared secret VoIP.ms must send back to us to validate inbound SMS/MMS
# webhook requests, if/when the callback URL is configured in the portal.
VOIPMS_WEBHOOK_SECRET=

# Path to the SQLite database file.
DB_PATH=./data/sms-app.db

# Where uploaded MMS attachments are stored. Defaults under the same
# ./data directory as DB_PATH, so it rides along on the existing volume
# mount without needing a separate one.
UPLOADS_DIR=./data/uploads

# Locks CORS to a single origin in production - set this to your deployed
# domain (e.g. https://sms.example.com). Leave unset to allow any origin.
PUBLIC_ORIGIN=

# Web Push VAPID keypair. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Push notifications are disabled (not a startup failure) until both are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI push services may use if something's wrong with your usage.
VAPID_SUBJECT=mailto:admin@example.com

# Optional: notify a UCM-style PBX extension by SIP MESSAGE (via AMI) when a
# text arrives on a given DID - useful if you also have a desk phone on that
# line. One-way only (app -> phone), disabled until all of these are set.
# Only use plaintext AMI if the path to your PBX is already encrypted some
# other way (e.g. a VPN) - never expose AMI directly to the internet.
AMI_HOST=
AMI_PORT=7777
AMI_USERNAME=
AMI_PASSWORD=
AMI_NOTIFY_DID=
AMI_NOTIFY_EXTENSION=
